# Local development uses .local/prepatoz.sqlite if TURSO_DATABASE_URL is empty.
# Netlify must use a persistent remote SQLite-compatible database; local fallback
# is intentionally disabled in serverless functions.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
PREPATOZ_ADMIN_EMAIL=singhshasank50@gmail.com
# Generate this with: npm run setup:admin
PREPATOZ_ADMIN_PASSWORD_HASH=
